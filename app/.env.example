# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Scoring — Phase 4
# Get a free API key at https://openrouter.ai (sign up → Keys)
# Free models (ending :free) cost $0 — no credit card needed for basic usage
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# Your deployed site URL (used by the AI scoring trigger in submitApplication)
# In development this defaults to http://localhost:3000 automatically
NEXT_PUBLIC_SITE_URL=https://your-domain.com
